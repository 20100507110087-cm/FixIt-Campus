<%- include('partials/header') %>

<div style="max-width:850px;margin:25px auto">
  <span class="eyebrow">About the FixIt Campus</span>

  <h1 style="margin:8px 0 15px">
    A campus that works better for everyone.
  </h1>

  <p class="muted" style="font-size:17px">
    FixIt Campus is a campus maintenance and issue-reporting system that gives students and staff one place to report problems and lets responsible teams track work until it is resolved.
  </p>

  <div class="grid" style="grid-template-columns:repeat(2,minmax(0,1fr));margin-top:28px">
    <div class="panel">
      <div style="font-size:28px">📝</div>
      <h2 style="font-size:19px">Report clearly</h2>
      <p class="muted">
        Share the issue category, location, priority and description in one structured report.
      </p>
    </div>

    <div class="panel">
      <div style="font-size:28px">🔎</div>
      <h2 style="font-size:19px">Track progress</h2>
      <p class="muted">
        View submitted, in-progress and resolved issues without relying on word of mouth.
      </p>
    </div>

    <div class="panel">
      <div style="font-size:28px">🧰</div>
      <h2 style="font-size:19px">Coordinate repairs</h2>
      <p class="muted">
        Staff can assign a team and update the status as work progresses.
      </p>
    </div>

    <div class="panel">
      <div style="font-size:28px">🤝</div>
      <h2 style="font-size:19px">Build a better campus</h2>
      <p class="muted">
        A shared process helps campus members contribute to safer, more reliable spaces.
      </p>
    </div>
  </div>

  <div class="panel" style="margin-top:20px">
    <h2 style="font-size:19px">Example use case</h2>
    <p class="muted" style="margin-bottom:0">
      A student notices that the projector in Room 204 is not working. They submit a report with the location and details. Staff review it, assign IT Support, change the status to “In Progress,” and mark it “Resolved” after the projector is repaired.
    </p>
  </div>

  <div style="margin-top:25px">
    <a class="btn" href="/report">Report a campus issue →</a>
  </div>
</div>

<%- include('partials/footer') %>